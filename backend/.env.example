# Port the server listens on. Railway sets this automatically; only needed locally.
PORT=3001

# Postgres connection string, e.g. postgresql://user:password@host:5432/dbname
# On Railway, add a Postgres plugin and reference its DATABASE_URL.
DATABASE_URL=

# Set to "false" to disable SSL for local Postgres without SSL configured.
PGSSL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Refresh token for Google Drive, so re-auth isn't needed after a redeploy
# (the alternative, google-token.json on disk, is lost on ephemeral filesystems).
GOOGLE_REFRESH_TOKEN=

# Redirect URI for the separate Google Calendar OAuth flow (Calendar page).
# Reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above, but needs its own entry
# in the Google Cloud Console's "Authorized redirect URIs" list, and whoever's
# calendar this is must click through /auth/google-calendar themselves — the
# resulting refresh token is stored in the calendar_connections DB table, not
# an env var, since it belongs to a specific person rather than the app itself.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/auth/google-calendar/callback

# Drive folder ID that project folders live inside (Projects section). Every
# direct subfolder here is auto-created/linked as a Project when the Projects
# page's "Sync from Drive" is used, and this is also where new folders get
# created for projects made via "+ New Project". This folder MUST live outside
# the GOOGLE_DRIVE_FILES_ROOT_ID subtree below — if it's nested inside it,
# its contents will also show up as plain browsable folders in Drive Files.
GOOGLE_DRIVE_PROJECTS_ROOT_ID=1CI1aOrDyaWzf8mwKi_QacnfhZrRZAvcT

# Drive folder ID that "Sync from Drive" reads from (Drive Files section).
# This is a pure mirror — everything found here becomes a browsable folder/file
# and is never linked to or merged into a Project, even if names happen to match.
GOOGLE_DRIVE_FILES_ROOT_ID=1cv0Mz_69aX4-7QJZphQ6_VOo16BGRWfd

# Resend API key, used by the daily task/calendar digest email (npm run digest).
RESEND_API_KEY=

# Sender address — must be on a domain verified in Resend (e.g. digest@asharufl.com).
DIGEST_FROM_EMAIL=

# Recipient address for the daily digest.
DIGEST_TO_EMAIL=

# Timezone used to determine "today" when picking tasks/events for the digest,
# e.g. America/New_York. Defaults to UTC if unset — set this or 10:30am cron
# fires at the wrong local time.
DIGEST_TIMEZONE=
